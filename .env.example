# Models. Agent mode needs one of these; fast mode runs without a model.
# Bedrock is used when boto3 finds AWS credentials, otherwise the first key set below.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_GATE2_MODEL=claude-haiku-4-5
# ANTHROPIC_FALLBACKS=1        # server-side refusal fallbacks on Opus 5, 0 to turn off
# AWS_REGION=us-west-2
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# GATE2_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# XAI_API_KEY= / OPENAI_API_KEY=
# MODEL_PROVIDER=anthropic     # anthropic | bedrock | xai | openai

# Chain
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# REPUTATION_REGISTRY_ADDRESS=
# QUERY_SETTLEMENT_ADDRESS=
# DEPLOYER_PRIVATE_KEY=

# ClickHouse. Falls back to memory when unset or unreachable.
# Cloud: CLICKHOUSE_URL=https://<host>.clickhouse.cloud:8443
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=agentshield
CLICKHOUSE_DATABASE=agentshield

# API and console
AGENT_PORT=8000
AGENT_API_URL=http://127.0.0.1:8000
# AGENTCORE_RUNTIME_ARN=       # console calls AgentCore instead of AGENT_API_URL
# AGENT_RUNS_PER_WINDOW=8      # agent runs per client per 10 minutes
# MOCK_BACKEND=1               # UI against fixtures

# x402 (USDC on Base Sepolia)
# X402_PAY_TO=
# BUYER_PRIVATE_KEY=           # scripts/paying-agent.mjs
